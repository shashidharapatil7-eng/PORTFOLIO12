rules_version = '2';

// Copy-paste this whole file into Firebase Console → Storage → Rules →
// replace the default rules → Publish.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024; // 8MB per-file cap
    }
  }
}
